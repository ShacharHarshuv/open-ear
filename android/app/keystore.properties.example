# Copy this file to "keystore.properties" (same folder) and fill in real
# values if you want a stable debug signing key across builds. This file
# is gitignored, so your real credentials never get committed.
#
# If you don't create this file at all, the build just falls back to
# Android's own default auto-generated debug keystore - no setup needed.

storeFile=/absolute/path/to/your.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
